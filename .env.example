# ==============================================================================
# QueryMind Environment Configuration
# ==============================================================================

# Database Connection (Admin Read-Write)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=querymind

# Database Connection (Read-Only User for Safe Execution)
RO_DB_USER=querymind_readonly
RO_DB_PASS=readonly_secure_pass

# LLM Provider Configuration (OpenAI Compatible)
# Compatible with OpenAI, Groq, DeepSeek, Together, LM Studio, Ollama, etc.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Server Port
BACKEND_PORT=8008
FRONTEND_PORT=3000
